<?xml version="1.0"?>
<robot name="m0617_rail_prototype">
  <!-- Prototype dimensions. Validate all permanent rail specifications before fabrication. -->
  <material name="rail_aluminum">
    <color rgba="0.62 0.65 0.68 1.0"/>
  </material>
  <material name="rail_dark_metal">
    <color rgba="0.06 0.07 0.08 1.0"/>
  </material>
  <material name="rail_rubber">
    <color rgba="0.025 0.025 0.025 1.0"/>
  </material>

  <link name="world"/>

  <link name="rail_base_link">
    <visual>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry><box size="3.0 0.32 0.24"/></geometry>
      <material name="rail_aluminum"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.32" rpy="0 0 0"/>
      <geometry><box size="3.0 0.46 0.04"/></geometry>
      <material name="rail_aluminum"/>
    </visual>
    <visual>
      <origin xyz="0 0.17 0.355" rpy="0 0 0"/>
      <geometry><box size="2.88 0.035 0.035"/></geometry>
      <material name="rail_dark_metal"/>
    </visual>
    <visual>
      <origin xyz="0 -0.17 0.355" rpy="0 0 0"/>
      <geometry><box size="2.88 0.035 0.035"/></geometry>
      <material name="rail_dark_metal"/>
    </visual>
    <visual>
      <origin xyz="-1.18 0 0.07" rpy="0 0 0"/>
      <geometry><box size="0.16 0.82 0.07"/></geometry>
      <material name="rail_aluminum"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry><box size="0.16 0.82 0.07"/></geometry>
      <material name="rail_aluminum"/>
    </visual>
    <visual>
      <origin xyz="1.18 0 0.07" rpy="0 0 0"/>
      <geometry><box size="0.16 0.82 0.07"/></geometry>
      <material name="rail_aluminum"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.165" rpy="0 0 0"/>
      <geometry><box size="3.0 0.46 0.33"/></geometry>
    </collision>
  </link>

  <joint name="world_to_rail_base" type="fixed">
    <parent link="world"/>
    <child link="rail_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="rail_carriage_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.50 0.55 0.10"/></geometry>
      <material name="rail_aluminum"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.1175" rpy="0 0 0"/>
      <geometry><box size="0.46 0.46 0.035"/></geometry>
      <material name="rail_dark_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0675" rpy="0 0 0"/>
      <geometry><box size="0.50 0.55 0.135"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="35.0"/>
      <inertia ixx="0.990" ixy="0" ixz="0" iyy="0.747" iyz="0" izz="1.547"/>
    </inertial>
  </link>

  <joint name="rail_joint" type="prismatic">
    <parent link="rail_base_link"/>
    <child link="rail_carriage_link"/>
    <origin xyz="-1.25 0 0.37" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="2.5" effort="1000.0" velocity="1.5"/>
    <dynamics damping="80.0" friction="20.0"/>
  </joint>

  <!-- Attach the M0617 base_link to this mount link in the combined robot description. -->
  <link name="rail_robot_mount_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><cylinder radius="0.135" length="0.03"/></geometry>
      <material name="rail_dark_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><cylinder radius="0.135" length="0.03"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.0232" ixy="0" ixz="0" iyy="0.0232" iyz="0" izz="0.0456"/>
    </inertial>
  </link>

  <joint name="carriage_to_robot_mount" type="fixed">
    <parent link="rail_carriage_link"/>
    <child link="rail_robot_mount_link"/>
    <origin xyz="0 0 0.135" rpy="0 0 0"/>
  </joint>
</robot>
